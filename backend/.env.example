# Required
GEMINI_API_KEY=your_gemini_api_key_from_aistudio_google_com

# Optional
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated frontend origins allowed by CORS (add your Vercel URL in production)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Server-side voice fallbacks (used when the client doesn't send its own key)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
SARVAM_API_KEY=

# Live co-pilot (/ws/live)
LIVE_MODEL=gemini-3.8-live
# Optional access code the browser must send (recommended when deployed publicly)
DEMO_PASSCODE=
# Max concurrent live sessions and max minutes per session
MAX_LIVE_SESSIONS=2
LIVE_MAX_SECONDS=1800
# Optional: coach voice name, proactive audio (needs LIVE_API_VERSION=v1alpha)
LIVE_VOICE=
LIVE_API_VERSION=v1beta
LIVE_PROACTIVE=0
